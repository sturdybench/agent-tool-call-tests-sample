        {
          "role": "tool",
          "tool_name": "create_event",
          "tool_call_id": "c1",
          "content": "error: invalid date format, expected YYYY-MM-DD"
        }
      ],
      "expected": {
        "type": "tool_calls",
        "calls": [
          {
            "name": "create_event",
            "arguments": {
              "title": "Team sync",
              "date": "2027-03-12",
              "start_time": "14:00"
            }
          }
        ],
        "ordered": true
      },
      "scoring_note": "Pass if the call is repeated with date 2027-03-12 and the other fields unchanged."
    }
  ]
