              },
              "date": {
                "type": "string",
                "description": "YYYY-MM-DD"
              },
              "start_time": {
                "type": "string",
                "description": "HH:MM 24h"
              }
            },
            "required": [
              "title",
              "date",
              "start_time"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "search_notes",
          "description": "Search notes.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              }
            },
            "required": [
              "query",
              "limit"
            ],
            "additionalProperties": false
          }
        }
      ],
      "messages": [
        {
          "role": "user",
          "content": "Put 'Team sync' on my calendar for March 12, 2027 at 14:00."
        },
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "c1",
              "name": "create_event",
              "arguments": {
                "title": "Team sync",
                "date": "12/03/2027",
                "start_time": "14:00"
