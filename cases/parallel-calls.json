      "theme": "parallel-calls",
      "description": "Weather in two cities.",
      "tools": [
        {
          "name": "get_weather",
          "description": "Get current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "celsius",
                  "fahrenheit"
                ]
              }
            },
            "required": [
              "city",
              "unit"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "convert_amount",
          "description": "Convert an amount between currencies using a fixed table (arithmetic only).",
          "parameters": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number"
              },
              "from_currency": {
                "type": "string"
              },
              "to_currency": {
                "type": "string"
              }
            },
            "required": [
              "amount",
              "from_currency",
              "to_currency"
            ],
            "additionalProperties": false
          }
        }
      ],
      "messages": [
        {
